
# ==========================================
# Next.js Git Ignore
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build
/.next/
/out/
/build
/dist

# Production
/.vercel
/.netlify

# Testing
/coverage
/.nyc_output

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Environment Variables
.env
.env.*
!.env.example
!.env.sample

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE / Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Desktop.ini

# Temporary Files
*.tmp
*.temp
.cache/
.temp/

# Local Database
*.sqlite
*.sqlite3
*.db

# Sensitive Files
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account.json

# Docker
docker-compose.override.yml

# Miscellaneous
*.bak
*.backup
